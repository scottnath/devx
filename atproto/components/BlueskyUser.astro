---
import type { BlueskyActor } from '../types.js';
import { formatRelativeTime } from './_utils.js';

interface Props {
  actor: BlueskyActor;
  timestamp?: Date;
  timestampLabel?: string;
  class?: string;
}

const { actor, timestamp, timestampLabel, class: className = '' } = Astro.props;
const showTimestamp = timestamp && timestamp.getTime() > 0;
---

<div class:list={['bluesky-user', className]}>
  <a
    href={actor.profileUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="bluesky-user-link"
  >
    {actor.avatar && (
      <img src={actor.avatar} alt="" class="bluesky-user-avatar" loading="lazy" />
    )}
    <span class="bluesky-user-name">{actor.displayName || actor.handle}</span>
    <span class="bluesky-user-handle">@{actor.handle}</span>
  </a>
  {showTimestamp && (
    <time class="bluesky-user-time" datetime={timestamp!.toISOString()}>
      {timestampLabel ? `${timestampLabel} ` : ''}{formatRelativeTime(timestamp!)}
    </time>
  )}
</div>

<style>
  .bluesky-user {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .bluesky-user-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: inherit;
  }

  .bluesky-user-avatar {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .bluesky-user-name {
    font-weight: 600;
  }

  .bluesky-user-handle {
    font-size: 0.875rem;
    opacity: 0.7;
  }

  .bluesky-user-time {
    margin-left: auto;
    font-size: 0.875rem;
    opacity: 0.7;
  }
</style>
