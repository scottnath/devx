---
import { fetchQuotes, type PostQuote } from '../reactions.js';
import BlueskyUser from './BlueskyUser.astro';

interface Props {
  bskyPostUri?: string;
  quotes?: PostQuote[];
  title?: string;
  class?: string;
}

const {
  bskyPostUri,
  quotes: quotesOverride,
  title = 'Quotes',
  class: className = '',
} = Astro.props;

let quotes: PostQuote[] = quotesOverride ?? [];
let error: string | null = null;

if (quotesOverride === undefined && bskyPostUri) {
  try {
    ({ quotes } = await fetchQuotes(bskyPostUri));
  } catch (e) {
    error = e instanceof Error ? e.message : 'Failed to load quotes';
    console.error('Quotes fetch error:', e);
  }
}
---

<section class:list={['bluesky-quotes', className]}>
  <header class="bluesky-quotes-header">
    <h2 class="bluesky-quotes-title">
      {title}
      {quotes.length > 0 && <span class="bluesky-quotes-count">({quotes.length})</span>}
    </h2>
  </header>

  {!bskyPostUri && quotesOverride === undefined && (
    <p class="bluesky-quotes-empty">Quotes appear after the post is synced to Bluesky.</p>
  )}

  {bskyPostUri && error && <p class="bluesky-quotes-error">Unable to load quotes.</p>}

  {(bskyPostUri || quotesOverride !== undefined) && !error && quotes.length === 0 && (
    <p class="bluesky-quotes-empty">No quotes yet.</p>
  )}

  {quotes.length > 0 && (
    <ul class="bluesky-quotes-list">
      {quotes.map((quote) => (
        <li class="bluesky-quotes-item">
          <article class="bluesky-quote">
            <header class="bluesky-quote-header">
              <BlueskyUser actor={quote.author} timestamp={quote.quotedAt} />
              <a
                href={quote.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="bluesky-quote-link"
              >
                View →
              </a>
            </header>
            <p class="bluesky-quote-text">{quote.text}</p>
          </article>
        </li>
      ))}
    </ul>
  )}
</section>

<style>
  .bluesky-quotes {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, CanvasText 15%, Canvas);
  }

  .bluesky-quotes-header {
    margin-bottom: 1rem;
  }

  .bluesky-quotes-title {
    margin: 0;
    font-size: 1.25rem;
  }

  .bluesky-quotes-count {
    font-weight: normal;
    opacity: 0.7;
  }

  .bluesky-quotes-empty,
  .bluesky-quotes-error {
    opacity: 0.85;
    font-style: italic;
  }

  .bluesky-quotes-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .bluesky-quotes-item {
    margin: 0;
  }

  .bluesky-quote-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }

  .bluesky-quote-link {
    margin-left: auto;
    font-size: 0.875rem;
    opacity: 0.7;
  }

  .bluesky-quote-text {
    margin: 0;
    white-space: pre-wrap;
  }
</style>
