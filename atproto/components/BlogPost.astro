---
import BlueskyLikes from './BlueskyLikes.astro';
import BlueskyReposts from './BlueskyReposts.astro';
import BlueskyQuotes from './BlueskyQuotes.astro';
import BlogComments from './BlogComments.astro';

interface Props {
  title: string;
  description?: string;
  date: Date;
  ogImage?: string;
  bskyPostUri?: string;
  canonicalUrl?: string;
  showEngagement?: boolean;
}

const {
  title,
  description,
  date,
  ogImage,
  bskyPostUri,
  canonicalUrl,
  showEngagement = true,
} = Astro.props;
---

<article class="blog-post">
  <header class="blog-post-header">
    {ogImage && <img src={ogImage} alt={title} class="blog-post-og-image" />}
    <h1 class="blog-post-title">{title}</h1>
    {description && <p class="blog-post-description">{description}</p>}
    <time class="blog-post-date" datetime={date.toISOString()}>
      {date.toLocaleDateString('en-US', { dateStyle: 'long' })}
    </time>
  </header>
  <div class="blog-post-body">
    <slot />
  </div>
</article>

{showEngagement && (
  <>
    <BlueskyLikes bskyPostUri={bskyPostUri} />
    <BlueskyReposts bskyPostUri={bskyPostUri} />
    <BlueskyQuotes bskyPostUri={bskyPostUri} />
    <BlogComments bskyPostUri={bskyPostUri} canonicalUrl={canonicalUrl} />
  </>
)}

<style>
  .blog-post-description {
    font-size: 1.125rem;
    opacity: 0.85;
  }

  .blog-post-date {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.875rem;
    opacity: 0.7;
  }

  .blog-post-body :global(h2) {
    margin-top: 2rem;
  }

  .blog-post-og-image {
    max-width: 100%;
    height: auto;
    margin-bottom: 1rem;
  }
</style>
